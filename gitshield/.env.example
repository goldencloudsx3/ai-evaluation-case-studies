# ── GitShield Configuration ───────────────────────────────────────────────────
# Copy to .env and fill in your values.
# Never commit .env to git.

# GitHub personal access token (for private mode + higher API rate limits)
# Scopes needed: repo, read:user
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub username (used for private mode repo listing)
GITHUB_USERNAME=your_username

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat ID in the "id" field under "chat"
TELEGRAM_TOKEN=1234567890:ABCDefghIJKlmnOPQRstuvwXYZ
TELEGRAM_CHAT_ID=123456789

# ── Researcher info (used in disclosure drafts) ───────────────────────────────
RESEARCHER_NAME=Your Name
RESEARCHER_CONTACT=your@email.com

# ── Hunt settings ─────────────────────────────────────────────────────────────
# Minimum Immunefi bounty (USD) to include in /hunt target list
IMMUNEFI_MIN_BOUNTY=10000

# Whether to enable deep extraction (dangling blobs, pack files) by default
# Set to false to use deep mode only via /deep command or --deep flag
DEEP_SCAN_DEFAULT=true
