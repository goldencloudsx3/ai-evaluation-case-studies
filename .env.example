# KittyPaw Scanner — Environment Variables
# Copy this file to .env and fill in your values
# .env is in .gitignore and will NOT be committed

# ── Telegram Alerts ─────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_bot_token_here

# Your Telegram chat ID (run the get_chat_id.py helper to find this)
TELEGRAM_CHAT_ID=your_chat_id_here

# ── GitHub (optional — raises API rate limit from 60 to 5000 req/hr) ─────────
# Get a classic token at: github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=ghp_your_token_here

# ── Optional Proxy (Burp Suite / mitmproxy) ──────────────────────────────────
# Uncomment and set to route traffic through a proxy
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
